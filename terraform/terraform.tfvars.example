# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored and is
# excluded from VCS pushes, so it never lands in a pull request.

project_name = "synfra-app"
environment  = "dev"

# Debug logging (Terraform/OpenTofu has no console.log())
# When true, emits a JSON summary to stderr during apply.
# debug_logging_enabled = true

# ── Regions ──────────────────────────────────────────────────────────────────
primary_region   = "us-east-1"
secondary_region = "us-west-2"

# Must not overlap — overlapping ranges cannot be peered.
primary_vpc_cidr   = "10.0.0.0/16"
secondary_vpc_cidr = "10.1.0.0/16"

# Only needed if workloads must reach private addresses across regions. S3
# replication and DynamoDB global tables do NOT require it.
enable_vpc_peering = false

# ── Storage ──────────────────────────────────────────────────────────────────
# STANDARD_IA keeps standby storage cheap. Use STANDARD for active-active.
replica_storage_class = "STANDARD_IA"
force_destroy         = false

# ── Database ─────────────────────────────────────────────────────────────────
dynamodb_billing_mode         = "PAY_PER_REQUEST"
enable_point_in_time_recovery = true

# ── DNS failover ─────────────────────────────────────────────────────────────
# Off by default: it needs a hosted zone you already own. Until you enable it,
# the two regions exist but nothing routes traffic between them.
enable_dns_failover = false

# hosted_zone_id     = "Z0123456789ABCDEFGHIJ"
# dns_record_name    = "app.example.com"
# primary_endpoint   = "primary-alb-123.us-east-1.elb.amazonaws.com"
# secondary_endpoint = "secondary-alb-456.us-west-2.elb.amazonaws.com"
# health_check_path  = "/health"
# dns_ttl            = 60

tags = {
  Owner      = "platform-team"
  CostCenter = "engineering"
}
